// Site no Cloudflare Workers: arquivos estáticos de dist/ e as rotas /api/relay (carimbos de tempo) e /api/inmetro
// (worker/index.js). Build: ./build.sh (monta dist/); deploy: npx wrangler deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucentcrypto",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-18",
  "observability": { "enabled": true },
  "build": { "command": "./build.sh" },
  // Relay embutido (/api/relay): só o próprio site pode chamá-lo pelo navegador.
  // TSAs RFC 3161: o padrão de relay/src/index.js (FreeTSA, DigiCert; ICP-Brasil desligada).
  // Sem OpenTimestamps: o registro em Bitcoin leva horas e não acrescenta nada à prova do momento do lacre.
  "vars": {
    "ALLOWED_ORIGINS": "[\"https://lucentcrypto.org\", \"https://www.lucentcrypto.org\", \"https://lucentcrypto.jvdg-ufmg.workers.dev\"]",
    "OTS_CALENDARS": "[]"
  },
  // Lucent Votação: um Durable Object (SQLite) por reunião, o quadro público (worker/votacao.js).
  "durable_objects": { "bindings": [{ "name": "SESSAO", "class_name": "Sessao" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessao"] }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  }
}
